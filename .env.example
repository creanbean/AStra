# Required for live job discovery, AI navigation, and resume-grounded answers.
# The provider must support Responses + web_search and Chat Completions.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Uses system Chromium when available; otherwise run npx playwright install chromium.
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
PORT=3000
HOST=127.0.0.1
# Keep personal information in this ignored directory.
ASTRA_DATA_DIR=.astra
# Set when exposing the server beyond localhost; use a long random value.
ASTRA_ACCESS_TOKEN=

# Keep false on your computer so CAPTCHA/login can be completed manually.
ASTRA_HEADLESS=false
